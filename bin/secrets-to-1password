#!/usr/bin/env bash
#
# Store local secret files in 1Password as documents, and verify each upload
# by reading it back and comparing bytes.
#
#   bin/secrets-to-1password ~/.secrets/*.pem
#   bin/secrets-to-1password --vault Work --dry-run ~/.secrets/*
#   bin/secrets-to-1password --verify ~/.secrets/openai.key
#
# This script NEVER deletes or modifies the local file. Removing local copies
# is a separate, deliberate step -- see "what reads this file?" in the README.
#
# Files are stored as documents rather than credential fields on purpose:
# `op document create` reads the file directly, so no secret ever appears in
# argv, where any user on the box can see it via ps.
#
set -euo pipefail
umask 077

VAULT=Private
DRY_RUN=0
VERIFY_ONLY=0
UPDATE=0
files=()

usage() { sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --vault) VAULT=${2:?--vault needs a name}; shift 2 ;;
    --vault=*) VAULT=${1#*=}; shift ;;
    -n | --dry-run) DRY_RUN=1; shift ;;
    --verify) VERIFY_ONLY=1; shift ;;
    --update) UPDATE=1; shift ;;
    -h | --help) usage 0 ;;
    -*) printf 'unknown option: %s\n' "$1" >&2; usage 1 ;;
    *) files+=("$1"); shift ;;
  esac
done

[ ${#files[@]} -gt 0 ] || { printf 'no files given\n' >&2; usage 1; }

command -v op >/dev/null 2>&1 || {
  printf 'op (1Password CLI) not installed: brew install --cask 1password-cli\n' >&2
  exit 1
}

# A signed-in session is required for everything except --dry-run. The app's
# "Integrate with 1Password CLI" setting makes this biometric; otherwise
# `eval $(op signin)`.
if [ "$DRY_RUN" = 0 ] &&
   { ! op account list >/dev/null 2>&1 || [ -z "$(op account list 2>/dev/null)" ]; }; then
  printf 'op has no account configured. Either:\n' >&2
  printf '  1Password app -> Settings -> Developer -> Integrate with 1Password CLI\n' >&2
  printf '  or: op account add --address my.1password.com --email <you>\n' >&2
  exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

ok=0; failed=0; skipped=0

exists() { op document get "$1" --vault "$VAULT" --out-file /dev/null >/dev/null 2>&1; }

# verify TITLE FILE -- read the stored document back and compare bytes.
verify() {
  local title=$1 file=$2 out="$tmp/readback"
  rm -f "$out"
  if ! op document get "$title" --vault "$VAULT" --out-file "$out" >/dev/null 2>&1; then
    printf '  FAIL  %s: not retrievable from vault %s\n' "$title" "$VAULT" >&2
    return 1
  fi
  if cmp -s "$out" "$file"; then
    printf '  ok    %s (%s bytes verified)\n' "$title" "$(wc -c <"$file" | tr -d ' ')"
    rm -f "$out"
    return 0
  fi
  printf '  FAIL  %s: stored copy does not match local file\n' "$title" >&2
  rm -f "$out"
  return 1
}

for f in "${files[@]}"; do
  [ -f "$f" ] || { printf '  skip  %s (not a regular file)\n' "$f"; skipped=$((skipped+1)); continue; }
  title=$(basename "$f")

  if [ "$VERIFY_ONLY" = 1 ]; then
    verify "$title" "$f" && ok=$((ok+1)) || failed=$((failed+1))
    continue
  fi

  if [ "$DRY_RUN" = 1 ]; then
    printf '  would: op document create %s --title %s --vault %s\n' "$f" "$title" "$VAULT"
    continue
  fi

  if exists "$title"; then
    if [ "$UPDATE" = 1 ]; then
      op document edit "$title" "$f" --vault "$VAULT" >/dev/null
    else
      printf '  skip  %s already in vault %s (use --update to replace)\n' "$title" "$VAULT"
      verify "$title" "$f" >/dev/null 2>&1 ||
        printf '        NOTE: stored copy differs from this local file\n' >&2
      skipped=$((skipped+1))
      continue
    fi
  else
    op document create "$f" --title "$title" --vault "$VAULT" --tags dots,secrets >/dev/null
  fi

  if verify "$title" "$f"; then
    ok=$((ok+1))
    printf '        retrieve with: op document get %s --vault %s\n' "$title" "$VAULT"
  else
    failed=$((failed+1))
  fi
done

printf '\n%d stored/verified, %d skipped, %d failed\n' "$ok" "$skipped" "$failed"
[ "$failed" -eq 0 ]
