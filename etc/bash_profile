# ~/.bash_profile -- login bash only. Bash reads this INSTEAD of ~/.bashrc for
# login shells, so source .bashrc first and keep login-only work below it.

[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"

# nvm is slow and rarely needed; load it lazily via `nvm` on first use.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ] ||
   [ -s "${HOMEBREW_PREFIX:-/nonexistent}/opt/nvm/nvm.sh" ]; then
  nvm() {
    unset -f nvm
    dots_source "$NVM_DIR/nvm.sh" ||
      dots_source "${HOMEBREW_PREFIX:-/nonexistent}/opt/nvm/nvm.sh"
    nvm "$@"
  }
fi

dots_source "$HOME/.bash_profile.local"
return 0
