# ~/.zshrc -- interactive zsh.
#
# Same rule as ~/.bashrc: no stdout. zsh does not read this for `ssh host cmd`,
# but it does for `ssh -t` and for anything that starts a login shell.

dots_source() { [ -r "$1" ] || return 1; . "$1"; }

dots_source "$HOME/.shell/os.sh" || return 0

# --- oh-my-zsh (optional) ---------------------------------------------------
# Guarded: servers and fresh boxes generally do not have it, and an unguarded
# source here errors on every single login there.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  ZSH_THEME="${ZSH_THEME:-robbyrussell}"
  plugins=(git)
  . "$ZSH/oh-my-zsh.sh"
else
  # Minimal stand-in prompt: user@host cwd, plus the git branch when cheap.
  autoload -Uz vcs_info 2>/dev/null && {
    zstyle ':vcs_info:*' enable git
    zstyle ':vcs_info:git:*' formats ' (%b)'
    precmd() { vcs_info }
    setopt PROMPT_SUBST
    PROMPT='%n@%m %~${vcs_info_msg_0_} %# '
  } || PROMPT='%n@%m %~ %# '
fi

dots_source "$HOME/.shell/env.sh"
dots_source "$HOME/.shell/interactive.sh"

dots_source "$HOME/.zshrc.local"
return 0
