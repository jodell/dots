# Portable git config. Identity, signing keys and per-machine includes live in
# ~/.gitconfig.local (untracked) -- see the [include] at the bottom.

[core]
  whitespace = trailing-space,space-before-tab
  autocrlf = false
  safecrlf = true
  excludesfile = ~/.gitignore_global

[apply]
  whitespace = fix

[init]
  defaultBranch = main

[branch]
  autosetupmerge = true

[push]
  default = current

[pull]
  ff = only

# Commit signing uses SSH keys, not GPG: 1Password serves SSH keys through its
# agent and has no GPG agent, so an SSH key is the one secret that never has to
# touch disk. Which key is machine-local; see ~/.gitconfig.local.
[gpg]
  format = ssh

[gpg "ssh"]
  # Public keys you trust, so `git log --show-signature` verifies locally.
  # Regenerate with: make allowed-signers
  allowedSignersFile = ~/.ssh/allowed_signers

[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --no-merges
  lgm = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  co = checkout
  s = status
  d = diff
  ds = diff --name-status
  b = branch

[color]
  ui = true
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  pager = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

# Push over SSH, fetch over HTTPS. `insteadOf` would rewrite *all* github.com
# URLs -- including this repo's 30-odd vendor submodules -- and every clone on
# a machine without a GitHub key would then fail.
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

# Machine-local: user.name / user.email / user.signingkey, commit.gpgsign,
# work identities, credential helpers. Not tracked, and not an error if absent.
[include]
  path = ~/.gitconfig.local
