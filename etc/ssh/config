# ~/.ssh/config -- portable across macOS and Linux.
#
# Parsed top-down, FIRST match wins for each keyword. So: Include first,
# then most-specific hosts, then the Host * defaults last.

# Per-machine and work hosts (jump boxes, internal names, LAN addresses) go
# here, kept out of this repo. Requires OpenSSH >= 7.3 (2016), which covers
# macOS, Mint, Ubuntu, Debian and Raspberry Pi OS. Missing file is not an error.
Include ~/.ssh/config.local

# UseKeychain is Apple-only. This must precede the first use of the keyword or
# non-Apple ssh (including a stray Homebrew openssh) aborts before reaching it.
IgnoreUnknown UseKeychain

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_escher

Host *.amazonaws.com
  # EC2 hosts are rebuilt constantly, so pinning host keys is noise -- but
  # `no` also disables MITM detection outright. accept-new trusts first use
  # and still warns if a known host's key later changes.
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts.ephemeral

Host *
  # Agent forwarding is deliberately OFF by default: it lets root on any host
  # you connect to use your keys for as long as the session lives. Turn it on
  # per-host in ~/.ssh/config.local, e.g.
  #   Host bastion.example.com
  #     ForwardAgent yes
  ForwardAgent no
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_escher
  SendEnv LANG LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES
  ServerAliveInterval 60
  ServerAliveCountMax 3
