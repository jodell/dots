# ~/.bashrc -- read by every bash: interactive, non-interactive, and by sshd
# for `ssh host cmd`.
#
# HARD RULE: nothing in this path may write to stdout. Anything that prints
# corrupts rsync/scp/git-over-ssh ("protocol version mismatch -- is your shell
# clean?"). Keep diagnostics on stderr, or behind an interactive guard.

dots_source() { [ -r "$1" ] || return 1; . "$1"; }

dots_source "$HOME/.shell/os.sh" || return 0
dots_source "$HOME/.shell/env.sh"
dots_source "$HOME/.shell/interactive.sh"

dots_source "$HOME/.bashrc.local"
return 0
